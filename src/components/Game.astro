---
import '../styles/game.css';
---

<section id="game" hidden>
	<div class="sidebar-izquierda">
		<button id="logout-btn">Cerrar sesión</button>
		<div id="timer">0m 0s</div>
		<form id="game-form">
			<input
				type="number"
				id="cards-number"
				min="2"
				step="2"
				required
				placeholder="Número de cartes"
			/>
			<button type="submit" id="play-btn">Jugar</button>
		</form>
	</div>

	<div class="zona-juego">
		<div id="game-board"></div>
	</div>

	<div class="sidebar-derecha">
		<div class="ranking-panel">
			<h3>Ranking</h3>
			<table id="ranking-table">
				<thead>
					<tr>
						<th>Nº</th>
						<th>Username</th>
						<th>Mail</th>
						<th>Temps</th>
						<th>Nº Cartes</th>
					</tr>
				</thead>
				<tbody id="ranking-body"></tbody>
			</table>
		</div>
	</div>

</section>

<script>
	function init() {
		const game = document.getElementById('game');
		const gameForm = document.getElementById('game-form');
		const cardsNumberInput = document.getElementById('cards-number');
		const playBtn = document.getElementById('play-btn');
		const timerEl = document.getElementById('timer');
		const gameBoard = document.getElementById('game-board');
		const rankingBody = document.getElementById('ranking-body');

		let timerInterval = null;
		let seconds = 0;
		let currentNumCards = 0;
		let firstCard = null;
		let secondCard = null;
		let lockBoard = false;
		let matchedCount = 0;
		let lastRankingKey = null;

		const userId = sessionStorage.getItem('user');
		if (!userId) {
			game.hidden = true;
			return;
		}
		game.hidden = false;

		const DB_URL = import.meta.env.PUBLIC_DB_URL;

		async function loadRanking() {
			if (!DB_URL) return;

			const usersRes = await fetch(`${DB_URL}.json`);
			const usersData = await usersRes.json();
			const usersMap = {};
			if (usersData && typeof usersData === 'object') {
				for (const [key, value] of Object.entries(usersData)) {
					usersMap[key] = value || {};
				}
			}

			const baseUrl = DB_URL.replace(/\/users$/, '');
			const rankingRes = await fetch(`${baseUrl}/ranking.json`);
			const rankingData = await rankingRes.json();
			const rankingList = [];
			if (rankingData && typeof rankingData === 'object') {
				for (const [key, value] of Object.entries(rankingData)) {
					rankingList.push({ key, ...value });
				}
			}

			rankingList.sort((a, b) => {
				if (b.numCartes !== a.numCartes) return b.numCartes - a.numCartes;
				return a.temps - b.temps;
			});

			rankingBody.innerHTML = '';
			const total = rankingList.length;

			if (total <= 5) {
				rankingList.forEach((record, index) => {
					const user = usersMap[record.userId] || {};
					const tr = document.createElement('tr');
					if (record.key === lastRankingKey) tr.classList.add('highlight');
					tr.innerHTML = `
						<td>${index + 1}</td>
						<td>${user.username || 'Desconocido'}</td>
						<td>${user.email || 'Desconocido'}</td>
						<td>${formatTime(record.temps)}</td>
						<td>${record.numCartes || 0}</td>
					`;
					rankingBody.appendChild(tr);
				});
			} else {
				const newIndex = lastRankingKey ? rankingList.findIndex(r => r.key === lastRankingKey) : -1;

				if (newIndex >= 0 && newIndex < 5) {
					// El registro nuevo está entre los 5 primeros: mostrar los 5 primeros normalmente
					rankingList.slice(0, 5).forEach((record, index) => {
						const user = usersMap[record.userId] || {};
						const tr = document.createElement('tr');
						if (record.key === lastRankingKey) tr.classList.add('highlight');
						tr.innerHTML = `
							<td>${index + 1}</td>
							<td>${user.username || 'Desconocido'}</td>
							<td>${user.email || 'Desconocido'}</td>
							<td>${formatTime(record.temps)}</td>
							<td>${record.numCartes || 0}</td>
						`;
						rankingBody.appendChild(tr);
					});
				} else {
					// El registro nuevo NO está entre los 5 primeros
					for (let i = 0; i < 4; i++) {
						const record = rankingList[i];
						const user = usersMap[record.userId] || {};
						const tr = document.createElement('tr');
						tr.innerHTML = `
							<td>${i + 1}</td>
							<td>${user.username || 'Desconocido'}</td>
							<td>${user.email || 'Desconocido'}</td>
							<td>${formatTime(record.temps)}</td>
							<td>${record.numCartes || 0}</td>
						`;
						rankingBody.appendChild(tr);
					}

					const ellipsis1 = document.createElement('tr');
					ellipsis1.innerHTML = '<td colspan="5">...</td>';
					rankingBody.appendChild(ellipsis1);

					if (lastRankingKey && newIndex >= 4) {
						const record = rankingList[newIndex];
						const user = usersMap[record.userId] || {};
						const tr = document.createElement('tr');
						tr.classList.add('highlight');
						tr.innerHTML = `
							<td>${newIndex + 1}</td>
							<td>${user.username || 'Desconocido'}</td>
							<td>${user.email || 'Desconocido'}</td>
							<td>${formatTime(record.temps)}</td>
							<td>${record.numCartes || 0}</td>
						`;
						rankingBody.appendChild(tr);
					}

					const ellipsis2 = document.createElement('tr');
					ellipsis2.innerHTML = '<td colspan="5">...</td>';
					rankingBody.appendChild(ellipsis2);
				}
			}
		}

		async function saveRanking(temps, numCartes) {
			if (!DB_URL || !userId) return;

			const tempsVal = Number.isFinite(temps) ? temps : 0;
			const numCartesVal = Number.isFinite(numCartes) ? numCartes : 0;

			const baseUrl = DB_URL.replace(/\/users$/, '');
			const res = await fetch(`${baseUrl}/ranking.json`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ userId, temps: tempsVal, numCartes: numCartesVal }),
			});
			if (!res.ok) throw new Error('Error guardando ranking');
			const result = await res.json();
			lastRankingKey = result.name;
			await loadRanking();
		}

		async function fetchPokemonImages(count) {
			const ids = [];
			while (ids.length < count) {
				const id = Math.floor(Math.random() * 151) + 1;
				if (!ids.includes(id)) ids.push(id);
			}

			const pokemon = await Promise.all(
				ids.map(id =>
					fetch(`https://pokeapi.co/api/v2/pokemon/${id}`)
						.then(res => res.json())
						.then(data => ({
							id: data.id,
							image:
								data.sprites.other?.['official-artwork']?.front_default ||
								data.sprites.front_default
						}))
				)
			);
			return pokemon;
		}

		function formatTime(secs) {
			const s = Number.isFinite(secs) ? secs : 0;
			const m = Math.floor(s / 60);
			const seg = s % 60;
			return `${m}m ${seg}s`;
		}

		function startTimer() {
			seconds = 0;
			timerEl.textContent = formatTime(seconds);
			if (timerInterval) clearInterval(timerInterval);
			timerInterval = setInterval(() => {
				seconds++;
				timerEl.textContent = formatTime(seconds);
			}, 1000);
		}

		function stopTimer() {
			if (timerInterval) clearInterval(timerInterval);
		}

		function createBoard(numCards) {
			gameBoard.innerHTML = '';
			matchedCount = 0;
			lastRankingKey = null;
			currentNumCards = numCards;

			const pairsNeeded = numCards / 2;
			fetchPokemonImages(pairsNeeded).then(pokemon => {
				const cardsData = [...pokemon, ...pokemon].sort(() => Math.random() - 0.5);

				cardsData.forEach(pokemon => {
					const card = document.createElement('div');
					card.className = 'card';
					card.dataset.id = pokemon.id;
					card.dataset.image = pokemon.image;
					card.addEventListener('click', handleCardClick);
					gameBoard.appendChild(card);
				});
			});
		}

		function handleCardClick(e) {
			if (lockBoard) return;
			const card = e.currentTarget;

			if (card === firstCard || card.classList.contains('matched')) return;

			card.classList.add('flipped');
			card.style.backgroundImage = `url('${card.dataset.image}')`;

			if (!firstCard) {
				firstCard = card;
				return;
			}

			secondCard = card;
			lockBoard = true;

			if (firstCard.dataset.id === secondCard.dataset.id) {
				firstCard.classList.add('matched');
				secondCard.classList.add('matched');
				matchedCount += 2;
				resetTurn();

				const totalCards = currentNumCards;
				if (matchedCount === totalCards) {
					stopTimer();
					saveRanking(seconds, totalCards);
				}
			} else {
				setTimeout(() => {
					firstCard.classList.remove('flipped');
					secondCard.classList.remove('flipped');
					firstCard.style.backgroundImage = '';
					secondCard.style.backgroundImage = '';
					resetTurn();
				}, 1000);
			}
		}

		function resetTurn() {
			[firstCard, secondCard] = [null, null];
			lockBoard = false;
		}

		gameForm.addEventListener('submit', event => {
			event.preventDefault();

			const value = parseInt(cardsNumberInput.value, 10);

			if (
				!Number.isInteger(value) ||
				value <= 0 ||
				value % 2 !== 0
			) {
				return;
			}

			playBtn.textContent = 'Volver a jugar';
			stopTimer();
			createBoard(value);
			startTimer();
		});

		const logoutBtn = document.getElementById('logout-btn');
		if (logoutBtn) {
			logoutBtn.addEventListener('click', () => {
				sessionStorage.removeItem('user');
				location.reload();
			});
		}

		loadRanking();
	}

	init();
</script>
