<form id="userForm">
  <input type="email" id="email" required placeholder="Email" />
  <input type="text" id="username" required placeholder="Username" />
  <button type="submit">Enviar</button>
</form>

<script>
  const form = document.getElementById("userForm") as HTMLFormElement;
  const DB_URL = "https://practicajs-rogermane-6a38d-default-rtdb.europe-west1.firebasedatabase.app/users";

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const emailInput = (document.getElementById("email") as HTMLInputElement).value;
    const usernameInput = (document.getElementById("username") as HTMLInputElement).value;

    try {
      const usuarioNuevo = {
        email: emailInput,
        username: usernameInput
      }

      const createResponse = await fetch(`${DB_URL}.json`, {
        method: "POST",
        body: JSON.stringify(
          usuarioNuevo
        ),
      });

      if(!createResponse) console.error("No se ha podido crear")
      if(createResponse) console.info("Se ha creado correctamente")
      
    } catch (error) {
      console.error("Error de conexión con la base de datos:", error);
    }

    form?.reset();
  });
</script>
